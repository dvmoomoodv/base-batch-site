---
import '../styles/global.css';
import { site } from '../site.config';
import { pathFor } from '../lib/i18n';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · {site.productName.ko}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="frame in" style="padding-block:96px;display:grid;gap:16px;justify-items:start">
      <p class="eyebrow">404</p>
      <h1 style="font-size:32px;letter-spacing:-0.03em">페이지를 찾을 수 없습니다 · Page not found</h1>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn btn-solid" href={pathFor('ko')} hreflang="ko">한국어 홈</a>
        <a class="btn btn-line" href={pathFor('en')} hreflang="en" lang="en">English home</a>
      </div>
    </main>
  </body>
</html>
