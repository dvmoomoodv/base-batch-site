---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/noto-sans-kr/400.css';
import '@fontsource/noto-sans-kr/500.css';
import '@fontsource/noto-sans-kr/700.css';
import '../styles/global.css';
import { site, type Lang } from '../site.config';
import { useT, pathFor } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const title = `${site.productName[lang]} · ${t.hero_title}`;
// SITE_URL 이 없으면 상대 주소로 둔다 (도메인 미정).
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={t.meta_desc} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={abs(pathFor(lang))} />}
    {site.locales.map(l => <link rel="alternate" hreflang={l} href={abs(pathFor(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pathFor(site.defaultLocale))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta_desc} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
