---
import { site, type Lang } from '../site.config';
import { useT, pathFor } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const links = [
  ['#features', t.nav_features],
  ['#safety', t.nav_safety],
  ['#compare', t.nav_compare],
  ['#devx', t.nav_devx],
];
---
<header class="site-header">
  <div class="frame in header-row">
    <a class="brand" href="#top" aria-label={t.home_label}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M2 12h6M16 12h6" stroke="currentColor" stroke-width="1.75"/>
        <rect x="8" y="6" width="8" height="12" rx="2" fill="currentColor"/>
      </svg>
      <span class="brand-name">{site.productName[lang]}</span>
    </a>
    <nav class="nav" aria-label={t.nav_main_label}>
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="lang" role="group" aria-label={t.lang_label}>
      {site.locales.map(l => (
        <a href={pathFor(l)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
      ))}
    </div>
    <a class="btn btn-solid header-cta" href="#contact">{t.cta_contact}</a>
    <button class="menu-btn" type="button" id="menu-btn" aria-expanded="false" aria-controls="sheet" aria-label={t.menu_label}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
    </button>
  </div>
  <div class="sheet" id="sheet" hidden>
    <nav class="frame in" aria-label={t.menu_label}>
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
      <a href="#contact">{t.cta_contact}</a>
    </nav>
  </div>
</header>
