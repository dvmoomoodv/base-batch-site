---
// 모바일 전용 "N개 모두 보기" 버튼. 항목 수가 미리 보기 개수 이하이면 그리지 않는다.
import type { Lang } from '../site.config';
import { useT, fmt } from '../lib/i18n';

interface Props { group: string; total: number; limit: number; lang: Lang }
const { group, total, limit, lang } = Astro.props;
const t = useT(lang);
---
{total > limit && (
  <button class="m-more" type="button" data-more={group} aria-haspopup="dialog">
    {fmt(t.ms_all, total)}<span class="n">+{total - limit}</span>
  </button>
)}
