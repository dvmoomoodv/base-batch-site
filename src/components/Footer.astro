---
import { site, type Lang } from '../site.config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="frame in">
    <div><strong>{site.productName[lang]}</strong> · <span>{site.contactEmail}</span></div>
    <div class="mono">© {year}</div>
  </div>
</footer>
