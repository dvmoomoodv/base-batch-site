    "check:i18n": "node scripts/check-i18n.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "check:leaks": "node scripts/check-leaks.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.0.0",
    "@fontsource/geist-sans": "^5.0.0",
    "@fontsource/noto-sans-kr": "^5.0.0",
    "astro": "^4.16.0"
  }
}
