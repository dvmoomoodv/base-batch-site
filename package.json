{
  "name": "base-batch-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "외부 공개용 소개 사이트 (정적). base-batch 운영 UI·API 와 연결하지 않는다.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
